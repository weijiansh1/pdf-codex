{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "skipLibCheck": true, "jsx": "react-jsx", "resolveJsonModule": true,
    "esModuleInterop": true, "types": ["node"], "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["plugins/**/*.ts", "plugins/**/*.tsx", "scripts/**/*.ts", "tests/**/*.ts", "vite.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "plugins/**/dist"]
}
